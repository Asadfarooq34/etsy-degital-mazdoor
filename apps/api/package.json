{"dependencies":{"@digital-mazdoor/core":"0.1.0","dotenv":"^17.2.3","fastify":"^5.6.1"},"description":"Local API server for Digital Mazdoor (Fastify + SQLite). Runs on Asad's own computer only.","devDependencies":{"tsx":"^4.20.6","typescript":"^5.9.2","vitest":"^3.2.4","@types/node":"^24.0.0"},"main":"./dist/index.js","name":"@digital-mazdoor/api","scripts":{"build":"tsc -p tsconfig.json","dev":"tsx watch src/index.ts","start":"node dist/index.js","test":"vitest run","typecheck":"tsc -p tsconfig.json --noEmit"},"type":"module","version":"0.1.0"}