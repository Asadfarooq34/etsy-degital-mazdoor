# Copy to .env and fill in. NEVER commit .env — secrets stay on this machine only.
# Etsy keystring (personal app, read-only). Empty = fixture mode (no real API calls).
ETSY_API_KEY=
# Etsy shared secret (from the same app dashboard). REQUIRED: Etsy rejects the
# x-api-key header unless it is "keystring:shared_secret" (403 otherwise).
ETSY_SHARED_SECRET=
PORT=3001

# --- Auth cookie (Phase 3E domain architecture) ---
# COOKIE_DOMAIN: Domain attribute for the session cookie. Set in production
# when the app spans subdomains, e.g. ".yourdomain.com", so a login on
# app.yourdomain.com stays valid on yourdomain.com (and logout clears both).
# Leave UNSET for localhost dev — browsers reject Domain=localhost, and the
# default host-only cookie is correct there.
# The Secure flag is automatic: sent only when NODE_ENV=production (localhost
# dev runs over plain http, where a Secure cookie would never be returned).
# COOKIE_DOMAIN=.yourdomain.com
