# Copy to .env and fill in. NEVER commit .env — secrets stay on this machine only.
# Etsy keystring (personal app, read-only). Empty = fixture mode (no real API calls).
ETSY_API_KEY=
# Etsy shared secret (from the same app dashboard). REQUIRED: Etsy rejects the
# x-api-key header unless it is "keystring:shared_secret" (403 otherwise).
ETSY_SHARED_SECRET=
PORT=3001
